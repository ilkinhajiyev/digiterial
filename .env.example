NEXT_PUBLIC_SITE_URL=https://sochi.az
# Persistent directory outside the deploy folder. Holds catalog.json and uploaded media.
# CATALOG_DATA_DIR=/var/sochi-data
# Required in production (at least 16 characters). Development has a local-only fallback.
# ADMIN_SESSION_SECRET=
# Optional override for the development-only admin password (default: sochi-dev-admin)
# ADMIN_DEV_PASSWORD=
